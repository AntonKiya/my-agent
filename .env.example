# Service identity

# Name used in logs, tracing, and service metadata.
AGENT_SERVICE_SERVICE_NAME=my-agent

# Runtime tier that controls environment-specific safeguards.
AGENT_SERVICE_ENVIRONMENT=prod

# Enables extra diagnostics and development behavior when true.
AGENT_SERVICE_DEBUG=false

# Interface the HTTP server binds to inside the process.
AGENT_SERVICE_HOST=0.0.0.0

# Port exposed by the application HTTP server.
AGENT_SERVICE_PORT=8000

# Minimum severity level written to application logs.
AGENT_SERVICE_LOG_LEVEL=INFO

# Runtime queues and workers

# Time allowed for in-flight tasks to finish during shutdown.
AGENT_SERVICE_GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=30.0

# Maximum buffered inbound events waiting for processing.
AGENT_SERVICE_INBOUND_QUEUE_MAXSIZE=10000

# Maximum buffered outbound messages waiting for delivery.
AGENT_SERVICE_OUTBOUND_QUEUE_MAXSIZE=10000

# How long webhook intake waits when the inbound queue is full.
AGENT_SERVICE_INBOUND_PUBLISH_TIMEOUT_SECONDS=0.5

# How long processing waits when publishing outbound messages.
AGENT_SERVICE_OUTBOUND_PUBLISH_TIMEOUT_SECONDS=2.0

# Number of concurrent inbound event processors.
AGENT_SERVICE_INBOUND_WORKER_COUNT=16

# Pause after an inbound worker error before continuing.
AGENT_SERVICE_INBOUND_WORKER_ERROR_BACKOFF_SECONDS=0.5

# Number of concurrent outbound delivery processors.
AGENT_SERVICE_DELIVERY_WORKER_COUNT=8

# Pause after a delivery worker error before continuing.
AGENT_SERVICE_DELIVERY_WORKER_ERROR_BACKOFF_SECONDS=0.5

# Maximum attempts for sending an outbound message.
AGENT_SERVICE_DELIVERY_RETRY_MAX_ATTEMPTS=3

# Delay schedule between outbound delivery attempts.
AGENT_SERVICE_DELIVERY_RETRY_BACKOFF_SECONDS='[1.0,5.0,15.0]'

# Agent provider

# LLM backend adapter to use when agent execution is enabled.
AGENT_SERVICE_AGENT_PROVIDER=openrouter

# Chat model name passed to the selected LLM backend.
AGENT_SERVICE_AGENT_MODEL=openai/gpt-4.1-mini

# Maximum duration of one provider call.
AGENT_SERVICE_AGENT_TIMEOUT_SECONDS=90.0

# Maximum attempts for one agent run.
AGENT_SERVICE_AGENT_RETRY_MAX_ATTEMPTS=3

# Delay schedule between failed agent attempts.
AGENT_SERVICE_AGENT_RETRY_BACKOFF_SECONDS='[1.0,5.0,15.0]'

# Postgres

# Minimum database connections kept in the pool.
AGENT_SERVICE_POSTGRES_POOL_MIN_SIZE=4

# Maximum database connections opened by the pool.
AGENT_SERVICE_POSTGRES_POOL_MAX_SIZE=32

# Timeout for individual database commands.
AGENT_SERVICE_POSTGRES_COMMAND_TIMEOUT_SECONDS=15.0

# Redis cache

# Lifetime of cached conversation snapshots.
AGENT_SERVICE_REDIS_CONTEXT_SNAPSHOT_TTL_SECONDS=86400

# Conversation memory

# Enables background summarization of long conversations.
AGENT_SERVICE_MEMORY_COMPACTION_ENABLED=true

# Approximate context window size of the chat model.
AGENT_SERVICE_MEMORY_MODEL_CONTEXT_WINDOW_TOKENS=196600

# Tokens reserved so the model has room to answer.
AGENT_SERVICE_MEMORY_RESERVED_OUTPUT_TOKENS=16384

# Context usage threshold that schedules summarization.
AGENT_SERVICE_MEMORY_COMPACTION_TRIGGER_FRACTION=0.70

# Recent message share kept verbatim after summarization.
AGENT_SERVICE_MEMORY_RECENT_TAIL_FRACTION=0.25

# Maximum pending summarization jobs in memory.
AGENT_SERVICE_MEMORY_COMPACTION_QUEUE_MAXSIZE=5000

# Number of background summarization workers.
AGENT_SERVICE_MEMORY_COMPACTION_WORKER_COUNT=2

# Pause after a summarization worker error.
AGENT_SERVICE_MEMORY_COMPACTION_WORKER_ERROR_BACKOFF_SECONDS=0.5

# How long message processing waits to enqueue summarization.
AGENT_SERVICE_MEMORY_COMPACTION_PUBLISH_TIMEOUT_SECONDS=0.5

# Desired size of generated conversation summaries.
AGENT_SERVICE_MEMORY_COMPACTION_TARGET_SUMMARY_TOKENS=1000

# Model used for summaries when different from the chat model.
AGENT_SERVICE_MEMORY_COMPACTION_MODEL=openai/gpt-4.1-mini

# Local Docker services

# Application database name created by local Postgres.
POSTGRES_DB=agent_service

# Application database role created by local Postgres.
POSTGRES_USER=agent_service

# Password for the local application database role.
POSTGRES_PASSWORD=agent_service_local_password

# Isolated database name used by integration tests.
POSTGRES_TEST_DB=agent_service_test

# Isolated database role used by integration tests.
POSTGRES_TEST_USER=agent_service_test

# Password for the local integration-test database role.
POSTGRES_TEST_PASSWORD=agent_service_test_local_password

# Password required by the local Redis container.
REDIS_PASSWORD=agent_service_redis_local_password

# Storage connections

# Application Postgres connection string.
AGENT_SERVICE_POSTGRES_DSN=postgresql://agent_service:agent_service_local_password@127.0.0.1:5432/agent_service

# Integration-test Postgres connection string.
AGENT_SERVICE_TEST_POSTGRES_DSN=postgresql://agent_service_test:agent_service_test_local_password@127.0.0.1:5432/agent_service_test

# Redis connection string for hot conversation snapshots.
AGENT_SERVICE_REDIS_DSN=redis://:agent_service_redis_local_password@127.0.0.1:6379/0

# External secrets

# Telegram bot credential used for outbound API calls.
AGENT_SERVICE_TELEGRAM_BOT_TOKEN=

# Shared secret required on Telegram webhook requests.
AGENT_SERVICE_TELEGRAM_WEBHOOK_SECRET_TOKEN=

# OpenRouter credential used by the LLM provider.
AGENT_SERVICE_OPENROUTER_API_KEY=

# Logfire token used to export telemetry.
AGENT_SERVICE_LOGFIRE_TOKEN=

# Style settings

# Render a conservative Markdown subset in Telegram messages.
AGENT_SERVICE_TELEGRAM_RENDER_MARKDOWN=false
